# Postgres (Neon) connection string. Leave empty to use local SQLite at prisma/dev.db
DATABASE_URL=

# Anthropic API key for the AI note summary (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Vercel Blob token for photo uploads.
# Empty → photos are saved to public/uploads (local dev only).
BLOB_READ_WRITE_TOKEN=
