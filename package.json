{
  "name": "passionseed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:select && next dev",
    "build": "npm run db:select && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/select-db.mjs && prisma generate",
    "db:select": "node scripts/select-db.mjs",
    "db:push": "npm run db:select && prisma db push",
    "db:seed": "npm run db:select && tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "db:reset": "npm run db:select && prisma db push --force-reset && tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "test:summary": "tsx scripts/test-summary.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.9.0",
    "next": "16.4.6",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "optionalDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1"
  }
}
